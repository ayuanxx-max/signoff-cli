    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agent",
    "ai-agents",
    "anti-slop",
    "audit",
    "code-review",
    "coverage",
    "dsh",
    "fanout",
    "gates",
    "git-hooks",
    "mcp",
